{
  "compileOnSave": false,
  "composite": true,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@gym-app/auth/api": ["libs/auth/api/src/index.ts"],
      "@gym-app/auth/web": ["libs/auth/web/src/index.ts"],
      "@gym-app/keycloak": ["libs/keycloak/src/index.ts"],
      "@gym-app/product-research/api": ["libs/productResearch/api/src/index.ts"],
      "@gym-app/product-research/web": ["libs/productResearch/web/src/index.ts"],
      "@gym-app/shared/api": ["libs/shared/api/src/index.ts"],
      "@gym-app/shared/events": ["libs/shared/events-api/src/index.ts"],
      "@gym-app/shared/web": ["libs/shared/web/src/index.ts"],
      "@gym-app/shared-helpers": ["libs/shared-helpers/src/index.ts"],
      "@gym-app/ui": ["libs/ui/src/index.ts"],
      "@gym-app/ui/data-display/*": ["libs/ui/src/components/data-display/*/index.ts"],
      "@gym-app/ui/feedback/*": ["libs/ui/src/components/feedback/*/index.ts"],
      "@gym-app/ui/form/*": ["libs/ui/src/components/form/*/index.ts"],
      "@gym-app/ui/layout/*": ["libs/ui/src/components/layout/*/index.ts"],
      "@gym-app/ui/navigation/*": ["libs/ui/src/components/navigation/*/index.ts"],
      "@gym-app/ui/typography/*": ["libs/ui/src/components/typography/*/index.ts"],
      "@gym-app/ui/utility/*": ["libs/ui/src/components/utility/*/index.ts"],
      "@gym-app/ui/mui/*": ["libs/ui/src/mui/*"],
      "@gym-app/ui/hooks/*": ["libs/ui/src/hooks/*"],
      "@gym-app/ui/utils": ["libs/ui/src/utils/index.ts"],
      "@gym-app/user/api": ["libs/user/api/src/index.ts"],
      "@gym-app/user/emails": ["libs/user/emails/src/index.ts"],
      "@gym-app/user/types": ["libs/user/types/src/index.ts"],
      "@gym-app/user/web": ["libs/user/web/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
